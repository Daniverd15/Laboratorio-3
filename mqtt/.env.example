# Copiar a .env y completar. NUNCA subir .env con las claves reales al repo.
IOTC_ID_SCOPE=0ne00XXXXXX
IOTC_DEVICE_ID=mqtt-explicito-lab3
IOTC_DEVICE_KEY=PRIMARY_KEY_EN_BASE64
IOTC_SEND_INTERVAL=5
# QoS a usar hacia IoT Central: 0 o 1 (2 NO esta soportado por IoT Hub)
IOTC_QOS=1
# Numero de mensajes y termina (0 = infinito). Util para las mediciones.
IOTC_N=0
# Ruta opcional de un CSV con las mediciones por mensaje.
IOTC_CSV=
